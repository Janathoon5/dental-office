# Copy this file to .env and fill in your values.
# Never commit .env to git.

SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# In production, set this to your public URL(s), e.g. https://your-app.up.railway.app
CSRF_TRUSTED_ORIGINS=

# Leave this unset locally to use SQLite.
# On Railway, this is set automatically when you add a PostgreSQL database.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Email — leave unset locally (prints to console). In production, set:
# EMAIL_BACKEND=anymail.backends.resend.EmailBackend
# RESEND_API_KEY=your-resend-api-key
# DEFAULT_FROM_EMAIL=Dental Office <onboarding@resend.dev>

