# Copy this file to .env and fill in your values.
# Never commit .env to git.

SECRET_KEY=your-secret-key-here
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key permanently loses all encrypted patient data. Keep a secure backup.
FIELD_ENCRYPTION_KEY=your-field-encryption-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# In production, set this to your public URL(s), e.g. https://your-app.up.railway.app
CSRF_TRUSTED_ORIGINS=

# Leave this unset locally to use SQLite.
# On Railway, this is set automatically when you add a PostgreSQL database.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Email — leave unset locally (prints to console). In production, set:
# EMAIL_BACKEND=anymail.backends.resend.EmailBackend
# RESEND_API_KEY=your-resend-api-key
# DEFAULT_FROM_EMAIL=Dental Office <onboarding@resend.dev>

# Push notifications (patient messaging) — path to the Firebase service
# account JSON key. Get this from the Firebase console: Project Settings ->
# Service Accounts -> Generate new private key. Never commit that file.
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json

# S3 storage for dental X-rays/photos (imaging app). Leave unset locally to
# store uploads on local disk instead. Required in production. The bucket
# must have SSE (server-side encryption) enabled and public access blocked —
# images are only ever served via short-lived signed URLs.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1

